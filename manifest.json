{
  "manifest_version": 3,
  "name": "Bookmarks Home",
  "version": "1.0.0",
  "description": "Easily find, organize, and open your bookmarks.",
  "minimum_chrome_version": "118",
  "permissions": ["bookmarks", "favicon", "sidePanel", "storage", "tabs"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Bookmarks"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "chrome_url_overrides": {
    "newtab": "src/newtab/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
